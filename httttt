<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LILLY INVEST DAILY</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f5f7fb;
      color: #071a41;
    }

    .app {
      display: flex;
      min-height: 100vh;
    }

    /* SIDEBAR */
    .sidebar {
      width: 307px;
      background: #ffffff;
      border-right: 1px solid #e4e7ee;
      padding: 28px 16px;
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 13px;
      padding: 0 0 42px 0;
    }

    .logo-icon {
      width: 32px;
      height: 32px;
      border-radius: 9px;
      background: linear-gradient(135deg, #4355df, #00a98f);
    }

    .logo-text {
      font-size: 26px;
      font-weight: 800;
      color: #071a41;
    }

    .menu {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .menu-item {
      padding: 15px 7px;
      border-radius: 12px;
      font-size: 18px;
      color: #18325e;
      cursor: pointer;
      transition: 0.2s;
    }

    .menu-item:hover {
      background: #f0f2ff;
      color: #4355df;
    }

    .menu-item.active {
      background: #e9ebff;
      color: #4052db;
      font-weight: 700;
    }

    .category-title {
      margin: 34px 7px 12px;
      color: #8792a8;
      font-size: 15px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    /* MAIN */
    .main {
      margin-left: 307px;
      width: calc(100% - 307px);
      padding: 25px 48px 60px;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 36px;
    }

    .page-title {
      font-size: 31px;
      font-weight: 800;
    }

    .date-box {
      background: #ffffff;
      border: 1px solid #dfe3eb;
      border-radius: 13px;
      padding: 12px 18px;
      color: #65728a;
      font-size: 16px;
    }

    /* HERO */
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 390px;
      gap: 28px;
      margin-bottom: 32px;
    }

    .hero-card,
    .breadth-card {
      background: #ffffff;
      border: 1px solid #e1e5ed;
      border-radius: 24px;
      padding: 44px;
    }

    .update-badge {
      display: inline-block;
      background: #e4f8f0;
      color: #00a86b;
      font-weight: 700;
      padding: 8px 16px;
      border-radius: 30px;
      margin-bottom: 25px;
    }

    .hero-title {
      font-size: 43px;
      line-height: 1.3;
      margin-bottom: 20px;
      color: #06183b;
    }

    .hero-description {
      font-size: 20px;
      line-height: 1.45;
      color: #29466e;
      margin-bottom: 25px;
    }

    .disclaimer {
      color: #9aa5b8;
      font-size: 15px;
    }

    /* BREADTH */
    .breadth-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .breadth-title {
      color: #8290a7;
      font-size: 17px;
      letter-spacing: 1px;
      margin-bottom: 25px;
    }

    .gauge {
      width: 220px;
      height: 110px;
      border-radius: 220px 220px 0 0;
      background: conic-gradient(
        from 270deg,
        #15a96d 0deg 122deg,
        #e3e6ed 122deg 180deg
      );
      position: relative;
      overflow: hidden;
    }

    .gauge::after {
      content: "";
      position: absolute;
      width: 170px;
      height: 85px;
      background: white;
      border-radius: 170px 170px 0 0;
      left: 25px;
      bottom: 0;
    }

    .breadth-score {
      font-size: 40px;
      font-weight: 800;
      margin-top: -5px;
    }

    .positive {
      color: #00a86b;
      font-weight: 700;
      margin-top: 8px;
    }

    /* MARKET CARDS */
    .market-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 20px;
      margin-bottom: 40px;
    }

    .market-card {
      background: white;
      border: 1px solid #e1e5ed;
      border-radius: 20px;
      padding: 25px 24px;
    }

    .market-name {
      color: #8090a8;
      font-size: 16px;
      margin-bottom: 14px;
    }

    .market-value {
      color: #071a41;
      font-size: 25px;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .market-change {
      font-size: 15px;
      font-weight: 700;
    }

    .up {
      color: #00a86b;
    }

    .down {
      color: #ef4b4b;
    }

    /* LOWER CONTENT */
    .content-grid {
      display: grid;
      grid-template-columns: 1.4fr 0.8fr;
      gap: 28px;
    }

    .news-panel {
      background: #ffffff;
      border: 1px solid #e1e5ed;
      border-radius: 24px;
      padding: 32px;
    }

    .section-title {
      font-size: 24px;
      margin-bottom: 24px;
    }

    .news-item {
      display: flex;
      gap: 20px;
      padding: 20px 0;
      border-bottom: 1px solid #edf0f5;
    }

    .news-number {
      min-width: 45px;
      height: 45px;
      border-radius: 12px;
      background: #eef0ff;
      color: #4052db;
      display: flex;
      justify-content: center;
      align-items: center;
      font-weight: 800;
    }

    .news-category {
      color: #71809a;
      font-size: 13px;
      margin-bottom: 5px;
      text-transform: uppercase;
    }

    .news-title {
      font-size: 20px;
      font-weight: 700;
      line-height: 1.4;
      margin-bottom: 7px;
    }

    .news-desc {
      color: #6e7c92;
      line-height: 1.5;
    }

    .subscribe {
      background: linear-gradient(135deg, #4052db, #6253e8);
      color: white;
      border-radius: 24px;
      padding: 38px;
      min-height: 260px;
    }

    .subscribe h2 {
      font-size: 27px;
      margin-bottom: 15px;
    }

    .subscribe p {
      line-height: 1.6;
      margin-bottom: 25px;
      opacity: 0.9;
    }

    .subscribe button {
      background: white;
      color: #4052db;
      border: none;
      padding: 13px 22px;
      border-radius: 10px;
      font-weight: 700;
      cursor: pointer;
    }

    /* RESPONSIVE */
    @media (max-width: 1200px) {
      .market-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .hero-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 850px) {
      .sidebar {
        width: 220px;
      }

      .main {
        margin-left: 220px;
        width: calc(100% - 220px);
        padding: 20px;
      }

      .content-grid {
        grid-template-columns: 1fr;
      }

      .hero-title {
        font-size: 32px;
      }
    }

    @media (max-width: 650px) {
      .sidebar {
        display: none;
      }

      .main {
        margin-left: 0;
        width: 100%;
      }

      .market-grid {
        grid-template-columns: 1fr 1fr;
      }

      .topbar {
        align-items: flex-start;
        gap: 15px;
        flex-direction: column;
      }

      .hero-card,
      .breadth-card {
        padding: 25px;
      }
    }
  </style>
</head>

<body>

<div class="app">

  <!-- SIDEBAR -->
  <aside class="sidebar">

    <div class="logo">
      <div class="logo-icon"></div>
      <div class="logo-text">LILLY INVEST</div>
    </div>

    <nav class="menu">
      <div class="menu-item active">Bản tin sáng</div>
      <div class="menu-item">Thế giới</div>
      <div class="menu-item">Việt Nam</div>
      <div class="menu-item">Chứng khoán</div>
    </nav>

    <div class="category-title">Chuyên mục</div>

    <nav class="menu">
      <div class="menu-item">Vĩ mô</div>
      <div class="menu-item">Doanh nghiệp</div>
      <div class="menu-item">Hàng hóa</div>
      <div class="menu-item">Tiền số</div>
    </nav>

  </aside>


  <!-- MAIN -->
  <main class="main">

    <div class="topbar">
      <h1 class="page-title">Bản tin đầu ngày</h1>

      <div class="date-box" id="currentDate">
        THỨ TƯ · 29/07/2026
      </div>
    </div>


    <!-- HERO -->
    <section class="hero-grid">

      <div class="hero-card">

        <div class="update-badge">
          ● Cập nhật 06:00 giờ Việt Nam
        </div>

        <h2 class="hero-title">
          VN-Index phục hồi lên mốc 1.680 điểm nhờ lực cầu bắt đáy, khối ngoại đảo chiều mua ròng
        </h2>

        <p class="hero-description">
          Dòng tiền lan tỏa mạnh ở nhóm Chứng khoán và Thép giúp thị trường lấy lại sắc xanh,
          trong khi Nasdaq giảm 3,72% và dầu WTI chiết khấu hơn 10% qua đêm.
        </p>

        <div class="disclaimer">
          ⚠ Tài liệu tổng hợp thông tin · KHÔNG phải khuyến nghị giao dịch hay đầu tư
        </div>

      </div>


      <!-- BREADTH -->
      <div class="breadth-card">

        <div class="breadth-title">
          ĐỘ RỘNG THỊ TRƯỜNG
        </div>

        <div class="gauge"></div>

        <div class="breadth-score">
          68/100
        </div>

        <div class="positive">
          ▲ Nghiêng tích cực
        </div>

      </div>

    </section>


    <!-- MARKET DATA -->
    <section class="market-grid">

      <div class="market-card">
        <div class="market-name">VN-Index</div>
        <div class="market-value">1.680,62</div>
        <div class="market-change up">▲ 0,70%</div>
      </div>

      <div class="market-card">
        <div class="market-name">VN30</div>
        <div class="market-value">1.824,35</div>
        <div class="market-change up">▲ 0,99%</div>
      </div>

      <div class="market-card">
        <div class="market-name">Khối ngoại</div>
        <div class="market-value">+922,5 tỷ</div>
        <div class="market-change up">Mua ròng</div>
      </div>

      <div class="market-card">
        <div class="market-name">USD/VND</div>
        <div class="market-value">26.330</div>
        <div class="market-change up">▲ 0,10%</div>
      </div>

      <div class="market-card">
        <div class="market-name">Dầu WTI</div>
        <div class="market-value">82,54</div>
        <div class="market-change down">▼ 10,47%</div>
      </div>

      <div class="market-card">
        <div class="market-name">Nasdaq</div>
        <div class="market-value">24.876,91</div>
        <div class="market-change down">▼ 3,72%</div>
      </div>

    </section>


    <!-- NEWS -->
    <section class="content-grid">

      <div class="news-panel">

        <h2 class="section-title">
          📰 Điểm tin đáng chú ý
        </h2>

        <div class="news-item">

          <div class="news-number">01</div>

          <div>
            <div class="news-category">
              Chứng khoán Việt Nam
            </div>

            <div class="news-title">
              Dòng tiền bắt đáy giúp thị trường đảo chiều
            </div>

            <div class="news-desc">
              Lực cầu gia tăng tại nhóm vốn hóa lớn hỗ trợ VN-Index hồi phục,
              tâm lý nhà đầu tư dần cải thiện.
            </div>
          </div>

        </div>


        <div class="news-item">

          <div class="news-number">02</div>

          <div>
            <div class="news-category">
              Vĩ mô
            </div>

            <div class="news-title">
              Fed bước vào kỳ họp chính sách tiền tệ
            </div>

            <div class="news-desc">
              Thị trường toàn cầu tập trung vào tín hiệu chính sách lãi suất
              và triển vọng đồng USD.
            </div>
          </div>

        </div>


        <div class="news-item">

          <div class="news-number">03</div>

          <div>
            <div class="news-category">
              Hàng hóa
            </div>

            <div class="news-title">
              Giá dầu thế giới biến động mạnh
            </div>

            <div class="news-desc">
              Diễn biến giá dầu có thể tác động đến nhóm cổ phiếu dầu khí,
              vận tải và các ngành sử dụng nhiều năng lượng.
            </div>
          </div>

        </div>

      </div>


      <!-- SUBSCRIBE -->
      <div class="subscribe">

        <h2>
          Nhận bản tin mỗi sáng
        </h2>

        <p>
          Cập nhật nhanh những thông tin quan trọng về
          thị trường chứng khoán, kinh tế vĩ mô và các nhóm ngành
          đáng chú ý.
        </p>

        <button>
          Đăng ký nhận bản tin
        </button>

      </div>

    </section>

  </main>

</div>


<script>

  // TỰ ĐỘNG HIỂN THỊ NGÀY HIỆN TẠI

  const days = [
    "CHỦ NHẬT",
    "THỨ HAI",
    "THỨ BA",
    "THỨ TƯ",
    "THỨ NĂM",
    "THỨ SÁU",
    "THỨ BẢY"
  ];

  const now = new Date();

  const day = days[now.getDay()];

  const date =
    String(now.getDate()).padStart(2, "0") +
    "/" +
    String(now.getMonth() + 1).padStart(2, "0") +
    "/" +
    now.getFullYear();

  document.getElementById("currentDate").innerText =
    day + " · " + date;

</script>

</body>
</html>
